      "id": "mn-standard-deduction",
      "label": "Minnesota standard deduction",
      "show": true,
      "note": "Reduced by 3% of income over $244,400 and 10% over $337,800, never by more than 80%.",
      "value": {
        "sub": [
          {
            "status": {"single": 15300, "married": 30600}
          },
          {
            "if": {
              "gt": ["gross", 1107750]
            },
            "then": {
              "pct": 80,
              "of": {
                "status": {"single": 15300, "married": 30600}
              }
            },
            "else": {
              "min": [
                {
                  "pct": 80,
                  "of": {
                    "status": {"single": 15300, "married": 30600}
                  }
                },
                {
                  "sum": [
                    {
                      "pct": 3,
                      "of": {
                        "min": [
                          {
                            "max": [
                              0,
                              {
                                "sub": ["gross", 244400]
                              }
                            ]
                          },
                          93400
                        ]
                      }
                    },
                    {
                      "pct": 10,
                      "of": {
                        "max": [
                          0,
                          {
                            "sub": ["gross", 337800]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "mn-taxable",
      "label": "Minnesota taxable income",
      "show": true,
      "value": {
        "max": [
          0,
          {
            "sub": ["gross", "mn-standard-deduction"]
          }
        ]
      }
    },
    {
      "id": "mn-income-tax",
      "label": "Minnesota income tax",
      "group": "tax",
      "charge": {
        "brackets": {
          "status": {
            "single": [[0, 5.35], [33310, 6.8], [109430, 7.85], [203150, 9.85]],
            "married": [[0, 5.35], [48700, 6.8], [193480, 7.85], [337930, 9.85]]
          }
        },
        "of": "mn-taxable"
      }
    },
    {
      "id": "mn-pfml",
      "label": "Paid Leave",
      "group": "social",
      "note": "Half of the 0.88% premium, from January 2026, on wages up to $185,000.",
