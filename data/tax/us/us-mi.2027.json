{
  "id": "us-mi",
  "name": "Michigan",
  "appliesTo": "Residents of Michigan",
  "kind": "state",
  "country": "US",
  "parent": "us",
  "standalone": true,
  "taxYear": {
    "label": "2027",
    "start": "2027-01-01",
    "end": "2027-12-31"
  },
  "items": [
    {
      "id": "mi-income-tax",
      "label": "Michigan income tax",
      "group": "tax",
      "note": "4.25% after a $5,900 personal exemption each.",
      "charge": {
        "pct": 4.25,
        "of": {
          "max": [
            0,
            {
              "sub": [
                "us-wages",
                {
                  "mul": [
                    5900,
                    {
                      "status": {
                        "single": 1,
                        "married": 2
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "us-mi-city-tax",
      "label": "Detroit city income tax",
      "group": "tax",
      "note": "2.4% for residents, after a $600 exemption for you, your spouse on a joint return and each dependant.",
      "charge": {
        "option": "city",
        "cases": {
          "none": 0,
          "detroit": {
            "pct": 2.4,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    "us-wages",
                    {
                      "mul": [
                        600,
                        {
                          "sum": [
                            {
                              "status": {
                                "single": 1,
                                "married": 2
                              }
                            },
                            {
                              "input": "children"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "notModelled": [
    "City income taxes outside Detroit (Grand Rapids 1.5% and 22 other cities)"
  ],
  "provisional": [
    "The 4.25% rate is the 2026 rate; Treasury sets the 2027 rate in spring 2027",
    "The $5,900 personal exemption is the 2026 amount, carried over from 2026 until the 2027 figure is published"
  ],
