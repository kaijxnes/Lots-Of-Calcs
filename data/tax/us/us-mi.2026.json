  "items": [
    {
      "id": "mi-income-tax",
      "label": "Michigan income tax",
      "group": "tax",
      "note": "4.25% after a $5,900 personal exemption each.",
      "charge": {
        "pct": 4.25,
        "of": {
          "max": [
            0,
            {
              "sub": [
                "us-wages",
                {
                  "mul": [
                    5900,
                    {
                      "status": {
                        "single": 1,
                        "married": 2
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "us-mi-city-tax",
      "label": "Detroit city income tax",
      "group": "tax",
      "note": "2.4% for residents, after a $600 exemption for you, your spouse on a joint return and each dependant.",
      "charge": {
        "option": "city",
        "cases": {
          "none": 0,
          "detroit": {
            "pct": 2.4,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    "us-wages",
                    {
                      "mul": [
                        600,
                        {
                          "sum": [
                            {
                              "status": {
                                "single": 1,
                                "married": 2
                              }
                            },
                            {
                              "input": "children"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "notModelled": [
    "City income taxes outside Detroit (Grand Rapids 1.5% and 22 other cities)"
  ],
