{
  "id": "us-il",
  "name": "Illinois",
  "appliesTo": "Residents of Illinois",
  "kind": "state",
  "country": "US",
  "parent": "us",
  "standalone": true,
  "taxYear": {
    "label": "2027",
    "start": "2027-01-01",
    "end": "2027-12-31"
  },
  "items": [
    {
      "id": "il-exemption",
      "label": "Illinois personal exemption",
      "show": true,
      "note": "$2,850 per person, lost entirely above $250,000 of income ($500,000 married).",
      "value": {
        "if": {
          "lte": [
            "us-wages",
            {
              "status": {
                "single": 250000,
                "married": 500000
              }
            }
          ]
        },
        "then": {
          "mul": [
            2850,
            {
              "status": {
                "single": 1,
                "married": 2
              }
            }
          ]
        },
        "else": 0
      }
    },
    {
      "id": "il-income-tax",
      "label": "Illinois income tax",
      "group": "tax",
      "charge": {
        "pct": 4.95,
        "of": {
          "max": [
            0,
            {
              "sub": [
                "us-wages",
                "il-exemption"
              ]
            }
          ]
        }
      }
    }
  ],
  "notModelled": [
    "Use tax that some filers pay on the income tax return"
  ],
  "provisional": [
    "Personal exemption of $2,850 is the 2025 amount, carried over from 2026 until the 2027 figure is published"
  ],
