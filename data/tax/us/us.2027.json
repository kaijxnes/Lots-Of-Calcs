{
  "id": "us",
  "name": "United States (federal)",
  "appliesTo": "Federal income tax and FICA, before any state tax",
  "kind": "country",
  "country": "US",
  "parent": null,
  "standalone": false,
  "currency": "USD",
  "locale": "en-US",
  "taxYear": {
    "label": "2027",
    "start": "2027-01-01",
    "end": "2027-12-31"
  },
  "options": {
    "status": {
      "label": "Filing status",
      "default": "single",
      "choices": {
        "single": "Single",
        "married": "Married filing jointly"
      }
    },
    "k401Pct": {
      "label": "401(k) contribution (% of pay)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "samples": [
        6,
        50
      ],
      "inSummary": false
    },
    "healthMonthly": {
      "label": "Pre-tax health insurance ($ a month)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 10000,
      "step": 10,
      "samples": [
        250
      ],
      "inSummary": false
    },
    "children": {
      "label": "Children under 17",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 10,
      "step": 1,
      "integer": true,
      "samples": [
        2
      ],
      "inSummary": false
    }
  },
  "items": [
    {
      "id": "us-401k-amount",
      "label": "401(k) contribution",
      "value": {
        "min": [
          {
            "pct": {
              "input": "k401Pct"
            },
            "of": "gross"
          },
          25500,
          {
            "pct": 85,
            "of": "gross"
          }
        ]
      },
      "note": "Traditional (pre-tax) 401(k) or 403(b) deferrals, up to the 2027 limit of $25,500 (catch-up contributions for 50 and over not included)."
    },
    {
      "id": "us-health-amount",
      "label": "Pre-tax health insurance",
      "value": {
        "min": [
          {
            "mul": [
              12,
              {
                "input": "healthMonthly"
              }
            ]
          },
          {
            "max": [
              0,
              {
                "sub": [
                  {
                    "pct": 85,
                    "of": "gross"
                  },
                  "us-401k-amount"
                ]
              }
            ]
          }
        ]
      },
      "note": "Your share of employer health, dental and vision premiums paid through a cafeteria (Section 125) plan. Together with the 401(k), capped at 85% of pay, since payroll can't deduct more than is left after taxes."
    },
    {
      "id": "us-wages",
      "label": "Taxable wages",
      "value": {
        "max": [
          0,
          {
            "sub": [
              "gross",
              "us-401k-amount",
              "us-health-amount"
            ]
          }
        ]
      },
      "note": "Pay after pre-tax deductions: what federal and most state income taxes start from."
    },
    {
      "id": "us-fica-wages",
      "label": "Social Security and Medicare wages",
      "value": {
        "max": [
          0,
          {
            "sub": [
              "gross",
              "us-health-amount"
            ]
          }
        ]
      },
      "note": "401(k) deferrals still pay Social Security and Medicare; cafeteria-plan premiums don't."
    },
    {
      "id": "us-standard-deduction",
      "label": "Federal standard deduction",
      "show": true,
      "value": {
        "status": {
          "single": 16600,
          "married": 33200
        }
      }
    },
    {
      "id": "us-taxable",
      "label": "Federal taxable income",
      "show": true,
      "value": {
        "max": [
          0,
          {
            "sub": [
              "us-wages",
              "us-standard-deduction"
            ]
          }
        ]
      }
    },
    {
      "id": "us-income-tax",
      "label": "Federal income tax",
      "group": "tax",
      "charge": {
        "brackets": {
          "status": {
            "single": [
              [
                0,
                10
              ],
              [
                12800,
                12
              ],
              [
                52025,
                22
              ],
              [
                109125,
                24
              ],
              [
                208325,
                32
              ],
              [
                264550,
                35
              ],
              [
                661375,
                37
              ]
            ],
            "married": [
              [
                0,
                10
              ],
              [
                25600,
                12
              ],
              [
                104050,
                22
              ],
              [
                218250,
                24
              ],
              [
                416650,
                32
              ],
              [
                529100,
                35
              ],
              [
                793650,
                37
              ]
            ]
          }
        },
        "of": "us-taxable"
      }
    },
    {
      "id": "us-ctc-max",
      "label": "Child Tax Credit available",
      "value": {
        "taper": {
          "mul": [
            2300,
            {
              "input": "children"
            }
          ]
        },
        "of": "us-wages",
        "from": {
          "status": {
            "single": 200000,
            "married": 400000
          }
        },
        "step": 1000,
        "perStep": 50
      },
      "note": "$2,300 per child under 17, reduced by $50 for each $1,000 (or part) of income over $200,000 ($400,000 married)."
    },
    {
      "id": "us-ctc-used",
      "label": "Child Tax Credit set against tax",
      "value": {
        "min": [
          "us-ctc-max",
          "us-income-tax"
        ]
      }
    },
    {
      "id": "us-actc",
      "label": "Refundable Child Tax Credit",
      "value": {
        "min": [
          {
            "sub": [
              "us-ctc-max",
              "us-ctc-used"
            ]
          },
          {
            "mul": [
              1800,
              {
                "input": "children"
              }
            ]
          },
          {
            "pct": 15,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    "us-wages",
                    2500
                  ]
                }
              ]
            }
          }
        ]
      },
      "note": "Up to $1,800 a child of any credit left over is paid out, limited to 15% of earnings over $2,500."
    },
    {
      "id": "us-child-tax-credit",
      "label": "Child Tax Credit",
      "group": "tax",
      "mayBeNegative": true,
      "note": "Comes off federal income tax; up to $1,800 a child can be paid out even where no tax is owed. A negative figure here adds to your take-home.",
      "charge": {
        "sub": [
          0,
          "us-ctc-used",
          "us-actc"
        ]
      }
    },
    {
      "id": "us-social-security",
      "label": "Social Security",
      "group": "social",
      "note": "6.2% of wages up to the 2027 wage base of $192,300.",
      "charge": {
        "pct": 6.2,
        "of": {
          "min": [
            "us-fica-wages",
            192300
          ]
        }
      }
    },
    {
      "id": "us-medicare",
      "label": "Medicare",
      "group": "social",
      "charge": {
        "pct": 1.45,
        "of": "us-fica-wages"
      }
    },
    {
      "id": "us-additional-medicare",
      "label": "Additional Medicare tax",
      "group": "social",
      "note": "0.9% on wages above $200,000 ($250,000 married filing jointly). Employers withhold it from $200,000 whatever the status; the threshold here is the liability.",
      "charge": {
        "pct": 0.9,
        "of": {
          "max": [
            0,
            {
              "sub": [
                "us-fica-wages",
                {
                  "status": {
                    "single": 200000,
                    "married": 250000
                  }
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "us-401k",
      "label": "401(k) contribution",
      "group": "pension",
      "charge": "us-401k-amount",
      "note": "Taken from pay before federal and most state income tax, but after Social Security and Medicare."
    },
    {
      "id": "us-pretax-health",
      "label": "Pre-tax health insurance",
      "group": "benefit",
      "charge": "us-health-amount",
      "note": "Taken before income tax, Social Security and Medicare."
    }
  ],
  "assumptions": [
    "Wages are the only income",
    "Married filing jointly means one spouse earns the whole salary and the other has no income",
    "Standard deduction, no itemizing",
    "No dependants, and under 65",
    "No 401(k), health premiums or children unless entered"
  ],
  "notModelled": [
    "Pre-tax 401(k), HSA and health insurance contributions",
    "Tax credits, including the child tax credit and earned income credit",
    "Itemized deductions, including state and local taxes (SALT) — high earners in high-tax states may pay less federal tax by itemizing",
    "The deductions for tips, overtime, car loan interest and seniors introduced for 2025–2028",
    "Alternative minimum tax",
    "Head of household, married filing separately and qualifying surviving spouse",
    "Roth 401(k) (after-tax), HSA and FSA contributions",
    "State child and dependent credits"
  ],
  "provisional": [],
  "sources": [
    {
      "title": "IRS Rev. Proc. 2026-35 — 2027 inflation adjustments (brackets, standard deduction, Child Tax Credit $2,300, refundable $1,800)",
      "url": "https://www.irs.gov/pub/irs-drop/rp-26-35.pdf"
    },
    {
      "title": "IRS IR-2026-133 — tax inflation adjustments for tax year 2027",
      "url": "https://www.irs.gov/newsroom/irs-releases-tax-inflation-adjustments-for-tax-year-2027-taxpayers-continue-to-benefit-from-the-working-families-tax-cuts"
    },
    {
      "title": "SSA Federal Register notice — 2027 contribution and benefit base $192,300",
      "url": "https://public-inspection.federalregister.gov/2026-21796.pdf"
    },
    {
      "title": "IRS Notice 2026-66 — 2027 401(k) elective deferral limit $25,500",
      "url": "https://www.irs.gov/pub/irs-drop/n-26-66.pdf"
    },
    {
      "title": "26 U.S.C. § 3101 — FICA rates, including the additional Medicare tax",
      "url": "https://www.law.cornell.edu/uscode/text/26/3101"
    },
    {
      "title": "Child Tax Credit (IRS)",
      "url": "https://www.irs.gov/credits-deductions/individuals/child-tax-credit-and-credit-for-other-dependents"
    }
  ],
  "obtainedFrom": [
    {
      "title": "IRS Rev. Proc. 2026-35, sections .01 (Tables 1 and 3), .05 and .15",
      "url": "https://www.irs.gov/pub/irs-drop/rp-26-35.pdf",
      "note": "Read 26 Nov 2026: brackets for single and married filing jointly, standard deductions $16,600 / $33,200, Child Tax Credit $2,300 and refundable portion $1,800."
    },
    {
      "title": "SSA notice, Federal Register document 2026-21796",
      "url": "https://public-inspection.federalregister.gov/2026-21796.pdf",
      "note": "\"The OASDI contribution and benefit base is $192,300 for remuneration paid in 2027\"."
    },
    {
      "title": "IRS Notice 2026-66",
      "url": "https://www.irs.gov/pub/irs-drop/n-26-66.pdf",
      "note": "\"The limitation under section 402(g)(1) ... is increased from $24,500 to $25,500.\""
    }
  ],
  "lastVerified": null,
  "lastChecked": "2026-11-26",
  "verifyAt": "https://www.irs.gov/pub/irs-drop/rp-26-35.pdf",
  "tests": [
    {
      "gross": 75000,
      "note": "Taxable 75,000 - 16,600 = 58,400: 12,800 × 10% = 1,280 + 39,225 × 12% = 4,707 + 6,375 × 22% = 1,402.50 → 7,389.50. SS 6.2% × 75,000 = 4,650. Medicare 1,087.50.",
      "expect": {
        "us-taxable": 58400.0,
        "us-income-tax": 7389.5,
        "us-social-security": 4650.0,
        "us-medicare": 1087.5,
        "us-additional-medicare": 0
      }
    },
    {
      "gross": 150000,
      "options": {
        "status": "married"
      },
      "note": "Taxable 150,000 - 33,200 = 116,800: 25,600 × 10% = 2,560 + 78,450 × 12% = 9,414 + 12,750 × 22% = 2,805 → 14,779.00.",
      "expect": {
        "us-income-tax": 14779.0,
        "us-social-security": 9300.0
      }
    },
    {
      "gross": 300000,
      "note": "Taxable 283,400: 60,349 (the schedule's figure at 264,550) + 18,850 × 35% = 6,597.50 → 66,946.50. SS capped at 192,300 × 6.2% = 11,922.60. Additional Medicare 100,000 × 0.9% = 900.",
      "expect": {
        "us-income-tax": 66946.5,
        "us-social-security": 11922.6,
        "us-medicare": 4350.0,
        "us-additional-medicare": 900.0
      }
    },
    {
      "gross": 75000,
      "options": {
        "children": 2
      },
      "note": "Tax 7,389.50 (as with no children); credit 2 × 2,300 = 4,600, all used against tax.",
      "expect": {
        "us-income-tax": 7389.5,
        "us-child-tax-credit": -4600
      }
    },
    {
      "gross": 25000,
      "options": {
        "children": 1
      },
      "note": "Taxable 8,400, tax 840. Credit 2,300: 840 against tax, the other 1,460 refundable (under 1,800 and under 15% × 22,500 = 3,375).",
      "expect": {
        "us-income-tax": 840.0,
        "us-actc": 1460.0,
        "us-child-tax-credit": -2300.0
      }
    },
    {
      "gross": 75000,
      "options": {
        "k401Pct": 6
      },
      "note": "401(k) 4,500: taxable 75,000 - 4,500 - 16,600 = 53,900; tax 1,280 + 4,707 + 1,875 × 22% = 412.50 → 6,399.50. Social Security still on 75,000: 4,650.",
      "expect": {
        "us-income-tax": 6399.5,
        "us-social-security": 4650.0,
        "us-401k": 4500.0
      }
    },
    {
      "gross": 75000,
      "options": {
        "healthMonthly": 200
      },
      "note": "Premiums 2,400 off before everything: Social Security 6.2% × 72,600 = 4,501.20, Medicare 1.45% × 72,600 = 1,052.70.",
      "expect": {
        "us-social-security": 4501.2,
        "us-medicare": 1052.7
      }
    },
    {
      "gross": 200000,
      "options": {
        "k401Pct": 50
      },
      "note": "50% would be 100,000; capped at the 25,500 limit.",
      "expect": {
        "us-401k": 25500
      }
    },
    {
      "gross": 410000,
      "options": {
        "status": "married",
        "children": 2
      },
      "note": "10,000 over the 400,000 threshold: 10 steps × 50 = 500 off 4,600.",
      "expect": {
        "us-ctc-max": 4100
      }
    }
  ]
}
