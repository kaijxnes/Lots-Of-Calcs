  "items": [
    {
      "id": "al-deduction",
      "label": "Alabama deduction",
      "show": true,
      "note": "The larger of the standard deduction — which shrinks above $25,500 of income to a floor of $2,500 ($5,000 married) — and itemizing, where Alabama lets employees deduct the Social Security and Medicare tax they pay.",
      "value": {
        "max": [
          {
            "max": [
              {
                "status": {"single": 2500, "married": 5000}
              },
              {
                "taper": {
                  "status": {"single": 3000, "married": 8500}
                },
                "of": "gross",
                "from": 25500,
                "step": 500,
                "perStep": {
                  "status": {"single": 25, "married": 175}
                },
                "stepMode": "floor"
              }
            ]
          },
          {
            "sum": ["us-social-security", "us-medicare", "us-additional-medicare"]
          }
        ]
      }
    },
    {
      "id": "al-taxable",
      "label": "Alabama taxable income",
      "show": true,
      "note": "Alabama lets you deduct the federal income tax you pay, plus a $1,500 personal exemption ($3,000 married).",
      "value": {
        "max": [
          0,
          {
            "sub": [
              "gross",
              "al-deduction",
              "us-income-tax",
              {
                "mul": [
                  1500,
                  {
                    "status": {"single": 1, "married": 2}
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "al-income-tax",
      "label": "Alabama income tax",
      "group": "tax",
      "charge": {
        "brackets": {
          "status": {
            "single": [[0, 2], [500, 4], [3000, 5]],
            "married": [[0, 2], [1000, 4], [6000, 5]]
          }
        },
        "of": "al-taxable"
      }
    }
  ],
  "notModelled": [
    "Local occupational taxes (Birmingham, Bessemer and others charge about 1%)",
    "Other Alabama itemized deductions (mortgage interest, property tax, charity), which would only add to the FICA deduction"
  ],
