  "items": [
    {
      "id": "de-pension",
      "label": "Pension insurance (Rentenversicherung)",
      "group": "social",
      "note": "Half of 18.6%, on earnings up to €101,400.",
      "charge": {
        "pct": 9.3,
        "of": {
          "min": ["gross", 101400]
        }
      }
    },
    {
      "id": "de-unemployment",
      "label": "Unemployment insurance (Arbeitslosenversicherung)",
      "group": "social",
      "note": "Half of 2.6%, on earnings up to €101,400.",
      "charge": {
        "pct": 1.3,
        "of": {
          "min": ["gross", 101400]
        }
      }
    },
    {
      "id": "de-health",
      "label": "Health insurance (Krankenversicherung)",
      "group": "social",
      "note": "Half of the 14.6% general rate plus half of the 2.9% average additional contribution, on earnings up to €69,750. Each fund sets its own additional contribution.",
      "charge": {
        "pct": 8.75,
        "of": {
          "min": ["gross", 69750]
        }
      }
    },
    {
      "id": "de-care",
      "label": "Long-term care insurance (Pflegeversicherung)",
      "group": "social",
      "note": "1.8% (half of 3.6%) plus the 0.6% surcharge for childless employees aged 23 or over, on earnings up to €69,750.",
      "charge": {
        "pct": 2.4,
        "of": {
          "min": ["gross", 69750]
        }
      }
    },
    {
      "id": "de-insurance-deduction",
      "label": "Deductible insurance contributions",
      "note": "Pension contributions in full, plus basic health (96%, excluding the share for sick pay) and care contributions — or up to €1,900 of all three if that is more.",
      "value": {
        "sum": [
          "de-pension",
          {
            "max": [
              {
                "sum": [
                  {"pct": 96, "of": "de-health"},
                  "de-care"
                ]
              },
              {
                "min": [
                  {
                    "sum": ["de-health", "de-care", "de-unemployment"]
                  },
                  1900
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "de-taxable",
      "label": "Taxable income (zu versteuerndes Einkommen)",
      "show": true,
      "note": "After the €1,230 employee allowance for work expenses, the €36 (€72 married) special expenses allowance, and insurance contributions.",
      "value": {
        "round": {
          "max": [
            0,
            {
              "sub": [
                "gross",
                1230,
                {
                  "status": {"single": 36, "married": 72}
                },
                "de-insurance-deduction"
              ]
            }
          ]
        },
        "to": 1,
        "mode": "down"
      }
    },
    {
      "id": "de-taxable-split",
      "label": "Income for the tariff",
      "note": "Married couples are taxed under income splitting: the tariff is applied to half the joint income and the result doubled.",
      "value": {
        "status": {
          "single": "de-taxable",
          "married": {
            "round": {
              "div": ["de-taxable", 2]
            },
            "to": 1,
            "mode": "down"
          }
        }
      }
    },
    {
      "id": "de-income-tax",
      "label": "Income tax (Einkommensteuer)",
      "group": "tax",
      "note": "§ 32a EStG 2026: nothing up to €12,348, rising through two progressive zones to 42% from €69,879 and 45% from €277,826.",
      "charge": {
        "mul": [
          {
            "status": {"single": 1, "married": 2}
          },
          {
            "round": {
              "if": {
                "lte": ["de-taxable-split", 12348]
              },
              "then": 0,
              "else": {
                "if": {
                  "lte": ["de-taxable-split", 17799]
                },
                "then": {
                  "quadratic": {"of": "de-taxable-split", "offset": 12348, "scale": 10000, "a": 914.51, "b": 1400}
                },
                "else": {
                  "if": {
                    "lte": ["de-taxable-split", 69878]
                  },
                  "then": {
                    "quadratic": {"of": "de-taxable-split", "offset": 17799, "scale": 10000, "a": 173.1, "b": 2397, "c": 1034.87}
                  },
                  "else": {
                    "if": {
                      "lte": ["de-taxable-split", 277825]
                    },
                    "then": {
                      "sub": [
                        {"pct": 42, "of": "de-taxable-split"},
                        11135.63
                      ]
                    },
                    "else": {
                      "sub": [
                        {"pct": 45, "of": "de-taxable-split"},
                        19470.38
                      ]
                    }
                  }
                }
              }
            },
            "to": 1,
            "mode": "down"
          }
        ]
      }
    },
    {
      "id": "de-solidarity",
      "label": "Solidarity surcharge",
      "group": "tax",
      "note": "5.5% of income tax, but only once the tax exceeds €20,350 (€40,700 married), phased in at 11.9% of the excess.",
      "charge": {
        "round": {
          "if": {
            "lte": [
              "de-income-tax",
              {
                "status": {"single": 20350, "married": 40700}
              }
            ]
          },
          "then": 0,
          "else": {
            "min": [
              {"pct": 5.5, "of": "de-income-tax"},
              {
                "pct": 11.9,
                "of": {
                  "sub": [
                    "de-income-tax",
                    {
                      "status": {"single": 20350, "married": 40700}
                    }
                  ]
                }
              }
            ]
          }
        },
        "to": 0.01,
        "mode": "down"
      }
    },
    {
      "id": "de-church",
      "label": "Church tax (Kirchensteuer)",
      "group": "tax",
      "note": "Only for members of a church that levies it: 8% of income tax in Bavaria and Baden-Württemberg, 9% elsewhere.",
      "charge": {
        "pct": {
          "option": "church",
          "cases": {"none": 0, "8": 8, "9": 9}
        },
        "of": "de-income-tax"
      }
    }
  ],
  "assumptions": [
    "Statutory health insurance at the average additional contribution of 2.9%",
    "No children, aged 23 or over (so the childless care surcharge applies)",
    "Calculated as the annual income tax assessment; monthly payroll withholding approximates it and the difference is settled by the annual return",
    "Married means one spouse earns the whole salary and the couple is jointly assessed"
