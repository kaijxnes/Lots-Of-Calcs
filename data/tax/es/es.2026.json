  "items": [
    {
      "id": "es-social-security",
      "label": "Social security (Seguridad Social)",
      "group": "social",
      "note": "4.70% common contingencies, 1.55% unemployment, 0.10% training and 0.15% intergenerational equity (MEI), on pay up to the maximum base of €5,101.20 a month.",
      "charge": {
        "pct": 6.5,
        "of": {
          "min": ["gross", 61214.4]
        }
      }
    },
    {
      "id": "es-net-earnings",
      "label": "Net earnings (rendimiento neto)",
      "note": "Pay less social security and the general €2,000 allowance for other expenses.",
      "value": {
        "max": [
          0,
          {
            "sub": ["gross", "es-social-security", 2000]
          }
        ]
      }
    },
    {
      "id": "es-earnings-reduction",
      "label": "Reduction for employment income",
      "note": "€7,302 for net earnings up to €14,852, tapering to nothing at €19,747.50.",
      "value": {
        "if": {
          "lte": ["es-net-earnings", 14852]
        },
        "then": 7302,
        "else": {
          "if": {
            "lte": ["es-net-earnings", 17673.52]
          },
          "then": {
            "sub": [
              7302,
              {
                "mul": [
                  1.75,
                  {
                    "sub": ["es-net-earnings", 14852]
                  }
                ]
              }
            ]
          },
          "else": {
            "if": {
              "lt": ["es-net-earnings", 19747.5]
            },
            "then": {
              "sub": [
                2364.34,
                {
                  "mul": [
                    1.14,
                    {
                      "sub": ["es-net-earnings", 17673.52]
                    }
                  ]
                }
              ]
            },
            "else": 0
          }
        }
      }
    },
    {
      "id": "es-base",
      "label": "Taxable base (base liquidable)",
      "show": true,
      "note": "Married couples filing jointly take a further €3,400 off.",
      "value": {
        "max": [
          0,
          {
            "sub": [
              "es-net-earnings",
              "es-earnings-reduction",
              {
                "status": {"single": 0, "married": 3400}
              }
            ]
          }
        ]
      }
    },
    {
      "id": "es-state-tax",
      "label": "Income tax — state share (IRPF estatal)",
      "group": "tax",
      "note": "The state scale, less the same scale applied to the €5,550 personal minimum.",
