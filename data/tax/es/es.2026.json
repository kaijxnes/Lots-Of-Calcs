        "max": [
          0,
          {
            "sub": [
              "es-net-earnings",
              "es-earnings-reduction",
              "es-pension-reduction",
              {
                "status": {
                  "single": 0,
                  "married": 3400
                }
              }
            ]
          }
        ]
      }
    },
    {
