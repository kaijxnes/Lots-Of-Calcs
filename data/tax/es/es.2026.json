              },
              {
                "brackets": [[0, 9.5], [12450, 12], [20200, 15], [35200, 18.5], [60000, 22.5], [300000, 24.5]],
                "of": {
                  "min": [5550, "es-base"]
                }
              }
            ]
          }
        ]
      }
    },
