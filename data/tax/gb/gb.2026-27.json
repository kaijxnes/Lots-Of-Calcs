  "items": [
    {
      "id": "gb-personal-allowance",
      "label": "Personal allowance",
      "show": true,
      "note": "Withdrawn by £1 for every £2 of income over £100,000, which is what creates the 60% effective band up to £125,140.",
      "value": {"taper": 12570, "of": "gross", "from": 100000, "per": 0.5}
    },
    {
      "id": "gb-taxable",
      "label": "Taxable income",
      "show": true,
      "value": {
        "max": [
          0,
          {
            "sub": ["gross", "gb-personal-allowance"]
          }
        ]
      }
    },
    {
      "id": "gb-income-tax",
      "label": "Income tax",
      "group": "tax",
      "note": "Thresholds are on taxable income, i.e. after the personal allowance.",
      "charge": {
        "brackets": [[0, 20, "Basic rate"], [37700, 40, "Higher rate"], [125140, 45, "Additional rate"]],
        "of": "gb-taxable"
      }
    },
    {
      "id": "gb-ni",
      "label": "National Insurance",
      "group": "social",
      "note": "Class 1 employee contributions, charged on gross pay rather than taxable income. Weekly thresholds of £241.73 and £966.73 are £12,570 and £50,270 a year.",
      "charge": {
        "brackets": [
          [0, 0, "Below the primary threshold"],
          [12570, 8, "Primary threshold to upper earnings limit"],
          [50270, 2, "Above the upper earnings limit"]
        ],
        "of": "gross"
      }
    },
    {
      "id": "gb-student-loan",
      "label": "Student loan repayment",
      "group": "loan",
      "note": "9% of earnings above the plan's yearly threshold: Plan 1 £26,900, Plan 2 £29,385, Plan 4 £33,795, Plan 5 £25,000. Collected through PAYE alongside tax.",
