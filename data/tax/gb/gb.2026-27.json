  "tests": [
    {
      "gross": 30000,
      "note": "Tax (30,000 − 12,570) × 20% = 3,486. NI (30,000 − 12,570) × 8% = 1,394.40.",
      "expect": {"gb-personal-allowance": 12570, "gb-income-tax": 3486, "gb-ni": 1394.4, "net": 25119.6}
    },
    {
      "gross": 60000,
      "note": "Taxable 47,430: 37,700 × 20% + 9,730 × 40% = 11,432. NI 37,700 × 8% + 9,730 × 2% = 3,210.60.",
      "expect": {"gb-income-tax": 11432, "gb-ni": 3210.6}
    },
    {
      "gross": 110000,
      "note": "Allowance 12,570 − 5,000 = 7,570; taxable 102,430: 7,540 + 64,730 × 40% = 33,432. NI 3,016 + 59,730 × 2% = 4,210.60.",
      "expect": {"gb-personal-allowance": 7570, "gb-income-tax": 33432, "gb-ni": 4210.6}
    },
    {
      "gross": 150000,
      "note": "No allowance; taxable 150,000: 7,540 + 87,440 × 40% + 24,860 × 45% = 53,703. NI 3,016 + 99,730 × 2% = 5,010.60.",
      "expect": {"gb-personal-allowance": 0, "gb-income-tax": 53703, "gb-ni": 5010.6}
    },
    {
      "gross": 40000,
      "options": {"studentLoan": "plan2"},
      "note": "Plan 2: 9% x (40,000 - 29,385) = 955.35; take-home 32,319.60 - 955.35.",
      "expect": {"gb-student-loan": 955.35, "net": 31364.25}
    },
    {
      "gross": 30000,
      "options": {"studentLoan": "plan1"},
      "note": "Plan 1: 9% x (30,000 - 26,900) = 279.",
      "expect": {"gb-student-loan": 279}
    },
    {
      "gross": 40000,
      "options": {"studentLoan": "plan4", "postgradLoan": "yes"},
      "note": "Plan 4: 9% x (40,000 - 33,795) = 558.45; postgraduate 6% x (40,000 - 21,000) = 1,140.",
      "expect": {"gb-student-loan": 558.45, "gb-postgrad-loan": 1140, "net": 30621.15}
    },
    {
      "gross": 24000,
      "options": {"studentLoan": "plan5"},
      "note": "Below the £25,000 Plan 5 threshold: nothing to repay.",
      "expect": {"gb-student-loan": 0}
    }
  ]
