  "items": [
    {
      "id": "nz-ietc",
      "label": "Independent earner tax credit",
      "show": true,
      "note": "$520 a year for incomes from $24,000 to $66,000, falling by 13 cents per dollar to nothing at $70,000.",
      "value": {
        "if": {
          "lt": ["gross", 24000]
        },
        "then": 0,
        "else": {
          "if": {
            "lte": ["gross", 66000]
          },
          "then": 520,
          "else": {
            "max": [
              0,
              {
                "sub": [
                  520,
                  {
                    "pct": 13,
                    "of": {
                      "sub": ["gross", 66000]
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "nz-income-tax",
      "label": "Income tax (PAYE)",
      "group": "tax",
      "note": "10.5% to $15,600, 17.5% to $53,500, 30% to $78,100, 33% to $180,000, 39% above.",
      "charge": {
        "max": [
          0,
          {
            "sub": [
              {
                "brackets": [[0, 10.5], [15600, 17.5], [53500, 30], [78100, 33], [180000, 39]],
                "of": "gross"
              },
              "nz-ietc"
            ]
          }
        ]
      }
    },
    {
      "id": "nz-acc",
      "label": "ACC earners' levy",
      "group": "social",
      "note": "1.75% of earnings up to $156,641 in 2026–27.",
      "charge": {
        "pct": 1.75,
        "of": {
          "min": ["gross", 156641]
        }
      }
    }
  ],
  "assumptions": [
    "Tax resident on a standard (M) tax code",
