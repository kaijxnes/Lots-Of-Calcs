{
  "id": "nz",
  "name": "New Zealand",
  "kind": "country",
  "country": "NZ",
  "parent": null,
  "standalone": true,
  "currency": "NZD",
  "locale": "en-NZ",
  "taxYear": {"label": "2026-27", "start": "2026-04-01", "end": "2027-03-31"},
  "options": {
    "kiwisaver": {
      "label": "KiwiSaver",
      "default": "none",
      "inSummary": false,
      "choices": {
        "none": "Not a member",
        "3": "3% (temporary rate)",
        "3.5": "3.5% (default)",
        "4": "4%",
        "6": "6%",
        "8": "8%",
        "10": "10%"
      }
    },
    "studentLoan": {
      "label": "Student loan",
      "default": "no",
      "inSummary": false,
      "choices": {"no": "No", "yes": "Yes"}
    }
  },
  "items": [
    {
      "id": "nz-ietc",
      "label": "Independent earner tax credit",
      "show": true,
      "note": "$520 a year for incomes from $24,000 to $66,000, falling by 13 cents per dollar to nothing at $70,000.",
      "value": {
        "if": {
          "lt": ["gross", 24000]
        },
        "then": 0,
        "else": {
          "if": {
            "lte": ["gross", 66000]
          },
          "then": 520,
          "else": {
            "max": [
              0,
              {
                "sub": [
                  520,
                  {
                    "pct": 13,
                    "of": {
                      "sub": ["gross", 66000]
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "nz-income-tax",
      "label": "Income tax (PAYE)",
      "group": "tax",
      "note": "10.5% to $15,600, 17.5% to $53,500, 30% to $78,100, 33% to $180,000, 39% above.",
      "charge": {
        "max": [
          0,
          {
            "sub": [
              {
                "brackets": [[0, 10.5], [15600, 17.5], [53500, 30], [78100, 33], [180000, 39]],
                "of": "gross"
              },
              "nz-ietc"
            ]
          }
        ]
      }
    },
    {
      "id": "nz-acc",
      "label": "ACC earners' levy",
      "group": "social",
      "note": "1.75% of earnings up to $156,641 in 2026–27.",
      "charge": {
        "pct": 1.75,
        "of": {
          "min": ["gross", 156641]
        }
      }
    },
    {
      "id": "nz-kiwisaver",
      "label": "KiwiSaver",
      "group": "pension",
      "note": "Your contribution as a percentage of gross pay; the default rose to 3.5% from 1 April 2026. Your employer's contribution goes on top and isn't taken from your pay.",
      "charge": {
        "pct": {
          "option": "kiwisaver",
          "cases": {"none": 0, "3": 3, "3.5": 3.5, "4": 4, "6": 6, "8": 8, "10": 10}
        },
        "of": "gross"
      }
    },
    {
      "id": "nz-student-loan",
      "label": "Student loan repayment",
      "group": "loan",
      "note": "12% of income over $24,128 a year.",
      "charge": {
        "option": "studentLoan",
        "cases": {
          "no": 0,
          "yes": {
            "pct": 12,
            "of": {
              "max": [
                0,
                {
                  "sub": ["gross", 24128]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "assumptions": [
    "Tax resident on a standard (M) tax code",
    "Not receiving Working for Families, NZ Super or a main benefit (which rule out the independent earner credit)"
  ],
  "notModelled": [
    "KiwiSaver contributions (employee default rate 3–4%)",
    "Student loan repayments (12% above the threshold)",
    "Secondary tax codes"
  ],
