{
  "id": "jp",
  "name": "Japan",
  "kind": "country",
  "country": "JP",
  "parent": null,
  "standalone": true,
  "currency": "JPY",
  "locale": "ja-JP",
  "taxYear": {"label": "2026", "start": "2026-01-01", "end": "2026-12-31"},
  "options": {
    "age": {
      "label": "Age",
      "default": "under40",
      "choices": {"under40": "Under 40", "40to64": "40 to 64"}
    }
  },
  "items": [
    {
      "id": "jp-health",
      "label": "Health insurance",
      "group": "social",
      "note": "Half of Kyōkai Kenpo's Tokyo rate (9.85%), plus half of the 1.62% long-term care rate for those aged 40 to 64.",
      "charge": {
        "mul": [
          {
            "sum": [
              4.925,
              {
                "option": "age",
                "cases": {"under40": 0, "40to64": 0.81}
              }
            ]
          },
          0.12,
          {
            "min": [
              {
                "div": ["gross", 12]
              },
              1390000
            ]
          }
        ]
      }
    },
    {
      "id": "jp-child-levy",
      "label": "Child and childcare support levy",
      "group": "social",
      "note": "Half of 0.23%, from April 2026 (nine months of the year).",
      "charge": {
        "mul": [
          0.08625,
          0.12,
          {
            "min": [
              {
                "div": ["gross", 12]
              },
              1390000
            ]
          }
        ]
      }
    },
    {
      "id": "jp-pension",
      "label": "Employees' pension insurance",
      "group": "social",
      "note": "Half of 18.3%, on monthly pay up to ¥650,000.",
      "charge": {
        "mul": [
          9.15,
          0.12,
          {
            "min": [
              {
                "div": ["gross", 12]
              },
              650000
            ]
          }
        ]
      }
    },
    {
      "id": "jp-employment",
      "label": "Employment insurance",
      "group": "social",
      "note": "0.5% for general businesses in FY2026.",
      "charge": {"pct": 0.5, "of": "gross"}
    },
    {
      "id": "jp-insurance",
      "label": "Social insurance total",
      "value": {
        "sum": ["jp-health", "jp-child-levy", "jp-pension", "jp-employment"]
      }
    },
    {
      "id": "jp-employment-income",
      "label": "Employment income (after the employment income deduction)",
      "show": true,
      "note": "The employment income deduction has a minimum of ¥740,000 for 2026 and 2027.",
      "value": {
        "sub": [
          "gross",
          {
            "min": [
              "gross",
              {
                "if": {
                  "lte": ["gross", 3600000]
                },
                "then": {
                  "max": [
                    740000,
                    {
                      "sum": [
                        {"pct": 30, "of": "gross"},
                        80000
                      ]
                    }
                  ]
                },
                "else": {
                  "if": {
                    "lte": ["gross", 6600000]
                  },
                  "then": {
                    "sum": [
                      {"pct": 20, "of": "gross"},
                      440000
                    ]
                  },
                  "else": {
                    "if": {
                      "lte": ["gross", 8500000]
                    },
                    "then": {
                      "sum": [
                        {"pct": 10, "of": "gross"},
                        1100000
                      ]
                    },
                    "else": 1950000
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "jp-basic-deduction",
      "label": "Basic deduction",
      "show": true,
      "note": "¥1,040,000 for total income up to ¥4.89 million, ¥670,000 up to ¥6.55 million, ¥620,000 up to ¥23.5 million, then tapering away.",
      "value": {
        "lookup": [
          [0, 1040000],
          [4890000, 670000],
          [6550000, 620000],
          [23500000, 480000],
          [24000000, 320000],
          [24500000, 160000],
          [25000000, 0]
        ],
        "of": "jp-employment-income",
        "strict": true
      }
    },
    {
      "id": "jp-taxable",
      "label": "Taxable income (national)",
      "show": true,
      "value": {
        "round": {
          "max": [
            0,
            {
              "sub": ["jp-employment-income", "jp-basic-deduction", "jp-insurance"]
            }
          ]
        },
        "to": 1000,
        "mode": "down"
      }
    },
    {
      "id": "jp-income-tax",
      "label": "Income tax (including reconstruction tax)",
      "group": "tax",
      "note": "5% to ¥1.95 million, then 10%, 20%, 23%, 33%, 40% and 45% above ¥40 million, plus the 2.1% special reconstruction income tax.",
      "charge": {
        "round": {
          "mul": [
            1.021,
            {
              "brackets": [[0, 5], [1950000, 10], [3300000, 20], [6950000, 23], [9000000, 33], [18000000, 40], [40000000, 45]],
              "of": "jp-taxable"
            }
          ]
        },
        "to": 1,
        "mode": "down"
      }
    },
    {
      "id": "jp-resident-taxable",
      "label": "Taxable income (resident tax)",
      "note": "Resident tax has its own basic deduction (¥430,000) and no temporary increase to the employment income deduction.",
      "value": {
        "round": {
          "max": [
            0,
            {
              "sub": [
                "gross",
                {
                  "min": [
                    "gross",
                    {
                      "if": {
                        "lte": ["gross", 3600000]
                      },
                      "then": {
                        "max": [
                          650000,
                          {
                            "sum": [
                              {"pct": 30, "of": "gross"},
                              80000
                            ]
                          }
                        ]
                      },
                      "else": {
                        "if": {
                          "lte": ["gross", 6600000]
                        },
                        "then": {
                          "sum": [
                            {"pct": 20, "of": "gross"},
                            440000
                          ]
                        },
                        "else": {
                          "if": {
                            "lte": ["gross", 8500000]
                          },
                          "then": {
                            "sum": [
                              {"pct": 10, "of": "gross"},
                              1100000
                            ]
                          },
                          "else": 1950000
                        }
                      }
                    }
                  ]
                },
                430000,
                "jp-insurance"
              ]
            }
          ]
        },
        "to": 1000,
        "mode": "down"
      }
    },
    {
      "id": "jp-resident-tax",
      "label": "Resident tax (jūminzei)",
      "group": "tax",
      "note": "10% of taxable income less the ¥2,500 adjustment credit, plus the ¥5,000 per-capita levy (including the forest environment tax). It is charged in the following year; shown here as if the salary were the same both years.",
      "charge": {
        "sum": [
          {
            "max": [
              0,
              {
                "sub": [
                  {"pct": 10, "of": "jp-resident-taxable"},
                  2500
                ]
              }
            ]
          },
          5000
        ]
      }
    }
  ],
  "assumptions": [
    "Salaried employee in Tokyo enrolled in Kyōkai Kenpo",
    "Paid in 12 equal monthly amounts with no bonus",
    "Single, no dependants"
  ],
  "notModelled": [
    "Bonuses (social insurance and withholding work differently on them)",
    "Spouse and dependant deductions",
    "Furusato nōzei and other deductions",
    "Corporate health insurance societies, whose rates differ"
  ],
  "provisional": [
    "Tokyo's 2026 health insurance rate of 9.85% comes from a third-party summary; Kyōkai Kenpo's own table confirms only that it fell from 9.91%"
  ],
