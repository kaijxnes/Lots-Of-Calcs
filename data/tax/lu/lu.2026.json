                          0.0054
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "id": "lu-cim",
      "label": "Single-parent tax credit (CIM)",
      "group": "tax",
      "mayBeNegative": true,
      "note": "€3,504 for taxable income under €60,000, falling by 6.12 cents per euro to €750 at €105,000 and above. Paid even when there is no tax to set it against; reduced if the child receives maintenance or other allowances above €2,712 a year.",
      "charge": {
        "option": "taxClass",
        "cases": {
          "1a-parent": {
            "sub": [
              0,
              {
                "if": {
                  "lt": [
                    "lu-taxable",
                    60000
                  ]
                },
                "then": 3504,
                "else": {
                  "if": {
                    "lte": [
                      "lu-taxable",
                      105000
                    ]
                  },
                  "then": {
                    "sub": [
                      3504,
                      {
                        "mul": [
                          {
                            "sub": [
                              "lu-taxable",
                              60000
                            ]
                          },
                          0.0612
                        ]
                      }
                    ]
                  },
                  "else": 750
                }
              }
            ]
          },
          "default": 0
        }
      }
    }
  ],
  "assumptions": [
    "Resident, paid in twelve equal months over 2026",
    "Class 1 (single, no children) unless you choose another class; class 2 assumes the household has this one salary",
    "Only the minimum allowances for work and special expenses"
  ],
  "notModelled": [
    "Child tax reductions (modération d'impôt pour enfants), given through family allowances",
    "Reduction of the single-parent credit for maintenance or allowances the child receives above €2,712 a year",
    "Couples where both partners earn (class 2 with two salaries)",
    "The temporary tax credit paid from June to December 2026 (crédit d'impôt conjoncture)",
    "Cross-border workers and non-resident tax",
    "Travel expense allowance (frais de déplacement) and actual expenses",
    "Rounding in the official tax tables and any smoothing at the solidarity surcharge threshold",
    "Benefits in kind and bonuses taxed at special rates"
  ],
  "provisional": [
    "The dependency contribution is treated as deductible like the other social contributions",
    "The ceiling and allowance from June are worked out from the €2,771.33 minimum wage"
  ],
