    {
      "id": "lu-solidarity",
      "label": "Solidarity surcharge (employment fund)",
      "group": "tax",
      "note": "7% of the income tax, or 9% when taxable income is over €150,000 (€300,000 in class 2).",
      "charge": {
        "mul": [
          "lu-income-tax",
          {
            "if": {
              "gt": [
                "lu-taxable",
                {
                  "option": "taxClass",
                  "cases": {
                    "2": 300000,
                    "default": 150000
                  }
                }
              ]
            },
            "then": 0.09,
            "else": 0.07
          }
        ]
      }
    },
    {
      "id": "lu-cis",
      "label": "Employee tax credit (CIS)",
      "group": "tax",
      "mayBeNegative": true,
      "note": "€300 plus 2.9% of pay over €936 up to €600 at €11,266; €600 to €40,000, then down 1.5 cents per euro to nothing at €80,000. Paid even when there is no tax to set it against.",
      "charge": {
        "sub": [
          0,
          {
            "if": {
              "lt": [
                "gross",
                936
              ]
            },
            "then": 0,
            "else": {
              "if": {
                "lte": [
                  "gross",
                  11265
                ]
              },
              "then": {
                "sum": [
                  300,
                  {
                    "mul": [
                      {
                        "sub": [
                          "gross",
                          936
                        ]
                      },
                      0.029
                    ]
                  }
                ]
              },
              "else": {
                "if": {
                  "lte": [
                    "gross",
                    40000
                  ]
                },
                "then": 600,
                "else": {
                  "max": [
                    0,
                    {
                      "sub": [
                        600,
                        {
                          "mul": [
                            {
                              "sub": [
                                "gross",
                                40000
                              ]
                            },
                            0.015
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": "lu-co2",
      "label": "CO2 tax credit (CI-CO2)",
      "group": "tax",
      "mayBeNegative": true,
      "note": "€216 up to €40,000 of pay, then down 0.54 cents per euro to nothing at €80,000.",
      "charge": {
        "sub": [
          0,
          {
            "if": {
              "lt": [
                "gross",
                936
              ]
            },
