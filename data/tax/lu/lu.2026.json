    {
      "id": "lu-cis",
      "label": "Employee tax credit (CIS)",
      "group": "tax",
      "mayBeNegative": true,
      "note": "€300 plus 2.9% of pay over €936 up to €600 at €11,266; €600 to €40,000, then down 1.5 cents per euro to nothing at €80,000. Paid even when there is no tax to set it against.",
      "charge": {
        "sub": [
          0,
          {
            "if": {
              "lt": [
                "gross",
                936
              ]
            },
            "then": 0,
            "else": {
              "if": {
                "lte": [
                  "gross",
                  11265
                ]
              },
              "then": {
                "sum": [
                  300,
                  {
                    "mul": [
                      {
                        "sub": [
