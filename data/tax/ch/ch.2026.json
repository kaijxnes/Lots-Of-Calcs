{
  "id": "ch",
  "name": "Switzerland (Zurich)",
  "kind": "country",
  "country": "CH",
  "parent": null,
  "standalone": true,
  "currency": "CHF",
  "locale": "de-CH",
  "taxYear": {
    "label": "2026",
    "start": "2026-01-01",
    "end": "2026-12-31"
  },
  "options": {
    "bvgPct": {
      "label": "Occupational pension (BVG), your share as % of coordinated salary",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.5,
      "samples": [
        5
      ],
      "inSummary": false
    }
  },
  "items": [
    {
      "id": "ch-ahv",
      "label": "AHV/IV/EO (old age, disability, loss of earnings)",
      "group": "social",
      "note": "5.3% of all salary, with no ceiling (the employer pays another 5.3%).",
      "charge": {
        "pct": 5.3,
        "of": "gross"
      }
    },
    {
      "id": "ch-alv",
      "label": "Unemployment insurance (ALV)",
      "group": "social",
      "note": "1.1% of salary up to CHF 148,200; nothing on salary above that.",
      "charge": {
        "pct": 1.1,
        "of": {
          "min": [
            "gross",
            148200
          ]
        }
      }
    },
    {
      "id": "ch-coordinated",
      "label": "Coordinated salary (BVG)",
      "show": false,
      "note": "Salary up to CHF 90,720 less the CHF 26,460 coordination deduction, at least CHF 3,780; nothing below the CHF 22,680 entry threshold.",
      "value": {
        "if": {
          "lt": [
            "gross",
            22680
          ]
        },
        "then": 0,
        "else": {
          "clamp": {
            "sub": [
              {
                "min": [
                  "gross",
                  90720
                ]
              },
              26460
            ]
          },
          "min": 3780,
          "max": 64260
        }
      }
    },
    {
      "id": "ch-bvg",
      "label": "Occupational pension (BVG)",
      "group": "pension",
      "note": "Your share of the pension fund contribution, if you enter one. The rate depends on your age and your employer's fund, so it is 0 unless you set it.",
      "charge": {
        "mul": [
          {
            "div": [
              {
                "input": "bvgPct"
              },
              100
            ]
          },
          "ch-coordinated"
        ]
      }
    },
    {
      "id": "ch-net-salary",
      "label": "Net salary",
      "show": false,
      "value": {
        "sub": [
          "gross",
          "ch-ahv",
          "ch-alv",
          "ch-bvg"
        ]
      }
    },
    {
      "id": "ch-prof-costs",
      "label": "Other professional costs (lump sum)",
      "show": true,
      "note": "3% of net salary, at least CHF 2,000 and at most CHF 4,000 — the same for federal and Zurich tax.",
      "value": {
        "clamp": {
          "pct": 3,
          "of": "ch-net-salary"
        },
        "min": 2000,
        "max": 4000
      }
    },
    {
      "id": "ch-fed-taxable",
      "label": "Taxable income (federal)",
      "show": true,
      "note": "Net salary less the professional costs lump sum and the CHF 1,800 insurance premiums deduction, rounded down to CHF 100.",
      "value": {
        "max": [
          0,
          {
            "round": {
              "sub": [
                "ch-net-salary",
                "ch-prof-costs",
                1800
              ]
            },
            "to": 100,
            "mode": "down"
          }
        ]
      }
    },
    {
