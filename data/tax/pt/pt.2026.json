{
  "id": "pt",
  "name": "Portugal",
  "kind": "country",
  "country": "PT",
  "parent": null,
  "standalone": true,
  "currency": "EUR",
  "locale": "pt-PT",
  "taxYear": {
    "label": "2026",
    "start": "2026-01-01",
    "end": "2026-12-31"
  },
  "options": {
    "status": {
      "label": "Filing",
      "default": "single",
      "choices": {
        "single": "Single",
        "married": "Married, joint return, one earner"
      }
    },
    "irsJovem": {
      "label": "IRS Jovem (aged 35 or under)",
      "default": "none",
      "inSummary": false,
      "choices": {
        "none": "Not claimed",
        "y1": "1st year of work income (100% exempt)",
        "y2to4": "2nd–4th year (75%)",
        "y5to7": "5th–7th year (50%)",
        "y8to10": "8th–10th year (25%)"
      }
    },
    "children": {
      "label": "Dependants",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 10,
      "step": 1,
      "integer": true,
      "samples": [
        1,
        3
      ],
      "inSummary": false
    },
    "childrenUnder7": {
      "label": "Of whom aged 6 or under",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 10,
      "step": 1,
      "integer": true,
      "samples": [
        2
      ],
      "inSummary": false
    }
  },
  "items": [
    {
      "id": "pt-social-security",
      "label": "Social security (Segurança Social)",
      "group": "social",
      "note": "11% of pay, with no ceiling.",
      "charge": {
        "pct": 11,
        "of": "gross"
      }
    },
    {
      "id": "pt-taxable",
      "label": "Taxable income (rendimento coletável)",
      "show": true,
      "note": "Pay less the specific deduction: €4,587.09 (8.54 × the 2026 social support index), or social security paid if more.",
      "value": {
        "max": [
          0,
          {
            "sub": [
              "gross",
              {
                "max": [
                  4587.09,
                  "pt-social-security"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "pt-tax-before-minimum",
      "label": "Tax at IRS rates",
      "note": "Married couples filing jointly apply the rates to half their joint income and double the result.",
      "value": {
        "mul": [
          {
            "status": {
              "single": 1,
              "married": 2
            }
          },
          {
            "brackets": [
              [
                0,
                12.2
              ],
              [
                8342,
                15.2
              ],
              [
                12587,
                20.7
              ],
              [
                17838,
                23.6
              ],
              [
                23089,
                30.6
              ],
              [
                29397,
                34.6
              ],
              [
                43090,
                43.1
              ],
              [
                46566,
                44.6
              ],
              [
                86634,
                48
              ]
            ],
            "of": {
              "div": [
                "pt-taxable",
                {
                  "status": {
                    "single": 1,
                    "married": 2
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "pt-jovem-exempt",
      "label": "IRS Jovem exempt pay",
      "show": true,
      "note": "100% of work income in the first year, 75% in years 2–4, 50% in years 5–7 and 25% in years 8–10, up to 55 × IAS (€29,542.15 in 2026) (CIRS art. 12.º-B).",
      "value": {
        "min": [
          29542.15,
          {
            "pct": {
              "option": "irsJovem",
              "cases": {
                "none": 0,
                "y1": 100,
                "y2to4": 75,
                "y5to7": 50,
                "y8to10": 25
              }
            },
            "of": "gross"
          }
        ]
      }
    },
    {
      "id": "pt-dependants",
      "label": "Deduction for dependants",
      "note": "€600 per dependant, plus €300 for each dependant from the second onward who is 6 or under (CIRS art. 78.º-A).",
      "value": {
        "sum": [
          {
            "mul": [
              600,
              {
                "input": "children"
              }
            ]
          },
          {
            "mul": [
              300,
              {
                "min": [
                  {
                    "input": "childrenUnder7"
                  },
                  {
                    "max": [
                      0,
                      {
                        "sub": [
                          {
                            "input": "children"
                          },
                          1
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "pt-irs",
      "label": "Income tax (IRS)",
      "group": "tax",
      "note": "2026 rates after the October 2026 cut (backdated to January). With IRS Jovem, the rate on all pay applies only to the part that is not exempt. Less the deduction for dependants. Tax may not leave less than the €12,880 subsistence minimum.",
      "charge": {
        "min": [
          {
            "max": [
              0,
              {
                "sub": [
                  {
                    "mul": [
                      "pt-tax-before-minimum",
                      {
                        "sub": [
                          1,
                          {
                            "div": [
                              "pt-jovem-exempt",
                              "gross"
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  "pt-dependants"
                ]
              }
            ]
          },
          {
            "max": [
              0,
              {
                "sub": [
                  "gross",
                  12880
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "pt-solidarity",
      "label": "Additional solidarity rate",
      "group": "tax",
      "note": "2.5% of taxable income between €80,000 and €250,000, 5% above.",
      "charge": {
        "sum": [
          {
            "pct": 2.5,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    {
                      "min": [
                        "pt-taxable",
                        250000
                      ]
                    },
                    80000
                  ]
                }
              ]
            }
          },
          {
            "pct": 5,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    "pt-taxable",
                    250000
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "assumptions": [
    "Mainland Portugal (the Azores and Madeira have lower rates)",
    "Employment (Category A) income only; the annual gross includes the 13th and 14th month payments",
    "No dependants",
    "IRS Jovem and dependants only if chosen"
  ],
  "notModelled": [
    "Non-habitual resident and IFICI regimes",
    "Personal deductions (general family expenses, health, education, housing)",
    "The Azores and Madeira regional rates",
    "The €126 extra for an only child under 3, and shared-custody halves of the dependant deduction",
    "Other deductions from tax (general family expenses, health, education, housing) still apply to IRS Jovem claimants as usual"
  ],
  "provisional": [
    "Monthly withholding in 2026 used the earlier rates; the annual return settles the difference"
  ],
