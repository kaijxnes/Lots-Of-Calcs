{
  "id": "dk",
  "name": "Denmark",
  "kind": "country",
  "country": "DK",
  "parent": null,
  "standalone": true,
  "currency": "DKK",
  "locale": "da-DK",
  "taxYear": {
    "label": "2026",
    "start": "2026-01-01",
    "end": "2026-12-31"
  },
  "options": {
    "municipality": {
      "label": "Municipality",
      "default": "average",
      "choices": {
        "average": "National average"
      }
    },
    "church": {
      "label": "Church member",
      "default": "no",
      "choices": {
        "no": "No",
        "yes": "Yes"
      }
    },
    "pensionPct": {
      "label": "Your pension contribution (% of pay)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 50,
      "step": 0.5,
      "samples": [
        4,
        8
      ],
      "inSummary": false
    }
  },
  "items": [
    {
      "id": "dk-atp",
      "label": "ATP pension contribution",
      "group": "social",
      "note": "DKK 99.48 a month for full-time employees.",
      "charge": {
        "min": [
          1193.76,
          "gross"
        ]
      }
    },
    {
      "id": "dk-am",
      "label": "Labour market contribution (AM-bidrag)",
      "group": "social",
      "note": "8% of pay after ATP.",
      "charge": {
        "pct": 8,
        "of": {
          "max": [
            0,
            {
              "sub": [
                "gross",
                "dk-atp"
              ]
            }
          ]
        }
      }
    },
    {
      "id": "dk-personal-income",
      "label": "Personal income",
      "show": true,
      "value": {
        "sub": [
          "gross",
          "dk-atp",
          "dk-am"
        ]
      }
    },
    {
      "id": "dk-pension-amount",
      "label": "Pension contribution",
      "note": "Your share of an employer-administered (labour market) pension, as a percentage of pay. It cannot exceed pay left after ATP and AM-bidrag.",
      "value": {
        "min": [
          {
            "pct": {
              "input": "pensionPct"
            },
            "of": "gross"
          },
          {
            "max": [
              0,
              "dk-personal-income"
            ]
          }
        ]
      }
    },
    {
      "id": "dk-pension-net",
      "label": "Pension contribution after AM-bidrag",
      "note": "AM-bidrag is still paid on the contribution (it stays in the AM-bidrag base, AMBL §2 stk. 1 nr. 4); the rest comes off personal income before tax.",
      "value": {
        "mul": [
          0.92,
          "dk-pension-amount"
        ]
      }
    },
    {
      "id": "dk-personal-income-taxed",
      "label": "Personal income after pension",
      "value": {
        "sub": [
          "dk-personal-income",
          "dk-pension-net"
        ]
      }
    },
    {
      "id": "dk-employment-deduction",
      "label": "Employment deduction (beskæftigelsesfradrag)",
      "note": "12.75% of pay, at most DKK 63,300. Pension contributions to employer schemes count towards it (LL §9 J refers to the AM-bidrag base).",
      "value": {
        "min": [
          63300,
          {
            "pct": 12.75,
            "of": {
              "sub": [
                "gross",
                "dk-atp"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "dk-job-deduction",
      "label": "Job deduction (jobfradrag)",
      "note": "4.5% of income above DKK 235,200, at most DKK 3,100.",
      "value": {
        "min": [
          3100,
          {
            "pct": 4.5,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    "dk-personal-income",
                    235200
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "dk-taxable",
      "label": "Taxable income",
      "show": true,
      "value": {
        "sub": [
          "dk-personal-income-taxed",
          "dk-employment-deduction",
          "dk-job-deduction"
        ]
      }
    },
    {
      "id": "dk-municipal",
      "label": "Municipal tax (kommuneskat)",
      "group": "tax",
      "note": "The national average rate, on taxable income above the DKK 54,100 personal allowance. Rates range from about 23.4% to 26.3%.",
      "charge": {
        "pct": {
          "option": "municipality",
          "cases": {
            "average": 25.05
          }
        },
        "of": {
          "max": [
            0,
            {
              "sub": [
                "dk-taxable",
                54100
              ]
            }
          ]
        }
      }
    },
    {
      "id": "dk-church",
      "label": "Church tax (kirkeskat)",
      "group": "tax",
      "note": "Members of the Church of Denmark only; about 0.87% on average.",
      "charge": {
        "pct": {
          "option": "church",
          "cases": {
            "no": 0,
            "yes": 0.87
          }
        },
        "of": {
          "max": [
            0,
            {
              "sub": [
                "dk-taxable",
                54100
              ]
            }
          ]
        }
      }
    },
    {
      "id": "dk-state",
      "label": "State tax (bundskat, mellemskat, topskat)",
      "group": "tax",
      "note": "Bottom tax 12.01% above the allowance; middle tax 7.5% above DKK 641,200; top tax 7.5% above DKK 777,900; top-top tax 5% above DKK 2,592,700 (the new 2026 structure).",
      "charge": {
        "sum": [
          {
            "pct": 12.01,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    "dk-personal-income-taxed",
                    54100
                  ]
                }
              ]
            }
          },
          {
            "pct": 7.5,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    "dk-personal-income-taxed",
                    641200
                  ]
                }
              ]
            }
          },
          {
            "pct": 7.5,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    "dk-personal-income-taxed",
                    777900
                  ]
                }
              ]
            }
          },
          {
            "pct": 5,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    "dk-personal-income-taxed",
                    2592700
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "dk-pension",
      "label": "Pension contribution",
      "group": "pension",
      "note": "What reaches your pension: the contribution less the 8% AM-bidrag on it.",
      "charge": {
        "sum": [
          "dk-pension-net"
        ]
      }
    }
  ],
  "assumptions": [
    "Full-time employee aged 18 or over",
    "No pension contributions through pay; each person is taxed individually"
  ],
  "notModelled": [
    "Individual municipal tax rates",
    "Senior and single-parent employment deductions",
    "Interest, union dues, commuting and other deductions",
    "Private (non-employer) pension savings and the employer's share of contributions"
  ],
  "provisional": [
    "The national average municipal rate is given as 24.94%–25.43% by different sources; 25.05% is used",
    "ATP amount is from a single secondary source"
  ],
