{
  "id": "fr",
  "name": "France",
  "kind": "country",
  "country": "FR",
  "parent": null,
  "standalone": true,
  "currency": "EUR",
  "locale": "fr-FR",
  "taxYear": {
    "label": "2026",
    "start": "2026-01-01",
    "end": "2026-12-31"
  },
  "options": {
    "status": {
      "label": "Household",
      "default": "single",
      "choices": {
        "single": "Single (1 share)",
        "married": "Married or PACS, one earner (2 shares)"
      }
    },
    "children": {
      "label": "Dependent children",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 10,
      "step": 1,
      "integer": true,
      "samples": [
        1,
        2,
        3
      ],
      "inSummary": false
    }
  },
  "items": [
    {
      "id": "fr-pension-basic",
      "label": "Basic state pension (assurance vieillesse)",
      "group": "social",
      "note": "6.9% of pay up to the social security ceiling (PASS, €48,060 in 2026) plus 0.4% of all pay.",
      "charge": {
        "sum": [
          {
            "pct": 6.9,
            "of": {
              "min": [
                "gross",
                48060
              ]
            }
          },
          {
            "pct": 0.4,
            "of": "gross"
          }
        ]
      }
    },
    {
      "id": "fr-pension-complementary",
      "label": "Complementary pension (Agirc-Arrco)",
      "group": "social",
      "note": "Agirc-Arrco 3.15% plus the 0.86% general balancing contribution up to the PASS, then 8.64% plus 1.08% up to 8 × PASS; and 0.14% (CET) on all pay up to 8 × PASS once pay exceeds the PASS.",
      "charge": {
        "sum": [
          {
            "brackets": [
              [
                0,
                4.01
              ],
              [
                48060,
                9.72
              ]
            ],
            "of": {
              "min": [
                "gross",
                384480
              ]
            }
          },
          {
            "if": {
              "gt": [
                "gross",
                48060
              ]
            },
            "then": {
              "pct": 0.14,
              "of": {
                "min": [
                  "gross",
                  384480
                ]
              }
            },
            "else": 0
          }
        ]
      }
    },
    {
      "id": "fr-csg-base",
      "label": "CSG base",
      "note": "98.25% of pay up to 4 × PASS (a 1.75% allowance for work expenses), and all pay above.",
      "value": {
        "sum": [
          {
            "pct": 98.25,
            "of": {
              "min": [
                "gross",
                192240
              ]
            }
          },
          {
            "max": [
              0,
              {
                "sub": [
                  "gross",
                  192240
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "fr-csg-crds",
      "label": "CSG and CRDS",
      "group": "social",
      "note": "CSG 9.2% (6.8% of it deductible from taxable income) and CRDS 0.5%.",
      "charge": {
        "pct": 9.7,
        "of": "fr-csg-base"
      }
    },
    {
      "id": "fr-net-taxable-pay",
      "label": "Net taxable pay (net imposable)",
      "show": true,
      "value": {
        "sub": [
          "gross",
          "fr-pension-basic",
          "fr-pension-complementary",
          {
            "pct": 6.8,
            "of": "fr-csg-base"
          }
        ]
      }
    },
    {
      "id": "fr-taxable",
      "label": "Taxable income",
      "show": true,
      "note": "After the automatic 10% deduction for work expenses (at least €509, at most €14,555).",
      "value": {
        "max": [
          0,
          {
            "sub": [
              "fr-net-taxable-pay",
              {
                "min": [
                  {
                    "clamp": {
                      "pct": 10,
                      "of": "fr-net-taxable-pay"
                    },
                    "min": 509,
                    "max": 14555
                  },
                  "fr-net-taxable-pay"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "fr-child-shares",
      "label": "Extra shares for children",
      "note": "Half a share each for the first two children and a whole share for each child from the third (CGI art. 194).",
      "value": {
        "sum": [
          {
            "mul": [
              0.5,
              {
                "min": [
                  {
                    "input": "children"
                  },
                  2
                ]
              }
            ]
          },
          {
            "max": [
              0,
              {
                "sub": [
                  {
                    "input": "children"
                  },
                  2
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "fr-lone-parent-share",
      "label": "Single parent's extra half-share",
      "note": "A single person bringing up children alone gets a further half-share (case T).",
      "value": {
        "if": {
          "gt": [
            {
              "input": "children"
            },
            0
          ]
        },
        "then": {
          "status": {
            "single": 0.5,
            "married": 0
          }
        },
        "else": 0
      }
    },
    {
      "id": "fr-shares",
      "label": "Household shares (parts)",
      "show": true,
      "value": {
        "sum": [
          {
            "status": {
              "single": 1,
              "married": 2
            }
          },
          "fr-child-shares",
          "fr-lone-parent-share"
        ]
      }
    },
    {
      "id": "fr-tax-with-shares",
      "label": "Tax with every share",
      "value": {
        "mul": [
          "fr-shares",
          {
            "brackets": [
              [
                0,
                0
              ],
              [
                11600,
                11
              ],
              [
                29579,
                30
              ],
              [
                84577,
                41
              ],
              [
                181917,
                45
              ]
            ],
            "of": {
              "div": [
                "fr-taxable",
                "fr-shares"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "fr-tax-adult-shares",
      "label": "Tax with the adults' shares only",
      "value": {
        "mul": [
          {
            "status": {
              "single": 1,
              "married": 2
            }
          },
          {
            "brackets": [
              [
                0,
                0
              ],
              [
                11600,
                11
              ],
              [
                29579,
                30
              ],
              [
                84577,
                41
              ],
              [
                181917,
                45
              ]
            ],
            "of": {
              "div": [
                "fr-taxable",
                {
                  "status": {
                    "single": 1,
                    "married": 2
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "id": "fr-qf-cap",
      "label": "Cap on the saving from children's shares",
      "note": "Each extra half-share can cut tax by at most €1,807; for a single parent the first child's whole share is capped at €4,262 instead (CGI art. 197, 2026).",
      "value": {
        "sum": [
          {
            "mul": [
              1807,
              2,
              "fr-child-shares"
            ]
          },
          {
            "mul": [
              2,
              "fr-lone-parent-share",
              2455
            ]
          }
        ]
      }
    },
    {
      "id": "fr-tax-before-decote",
      "label": "Income tax before the décote",
      "note": "The scale is applied to income per household share (quotient familial): one share for a single person, two for a married couple, more for children — but the saving from children's shares is capped.",
      "value": {
        "max": [
          "fr-tax-with-shares",
          {
            "sub": [
              "fr-tax-adult-shares",
              "fr-qf-cap"
            ]
          }
        ]
      }
    },
    {
      "id": "fr-income-tax",
      "label": "Income tax (impôt sur le revenu)",
      "group": "tax",
      "note": "Less the décote, which reduces small tax bills: €897 (€1,483 for a couple) minus 45.25% of the tax.",
      "charge": {
        "round": {
          "max": [
            0,
            {
              "sub": [
                "fr-tax-before-decote",
                {
                  "max": [
                    0,
                    {
                      "sub": [
                        {
                          "status": {
                            "single": 897,
                            "married": 1483
                          }
                        },
                        {
                          "pct": 45.25,
                          "of": "fr-tax-before-decote"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        "to": 1
      }
    },
    {
      "id": "fr-high-income",
      "label": "High income contribution (CEHR)",
      "group": "tax",
      "note": "3% of income between €250,000 and €500,000 and 4% above (thresholds doubled for couples).",
      "charge": {
        "sum": [
          {
            "pct": 3,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    {
                      "min": [
                        "fr-taxable",
                        {
                          "status": {
                            "single": 500000,
                            "married": 1000000
                          }
                        }
                      ]
                    },
                    {
                      "status": {
                        "single": 250000,
                        "married": 500000
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "pct": 4,
            "of": {
              "max": [
                0,
                {
                  "sub": [
                    "fr-taxable",
                    {
                      "status": {
                        "single": 500000,
                        "married": 1000000
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "assumptions": [
    "A private-sector employee who is not a cadre, outside Alsace-Moselle",
    "Married means one spouse earns the whole salary; children only if entered",
    "Employment income only"
  ],
  "notModelled": [
    "Employer-arranged health (mutuelle) and provident contributions, which typically add 1–2% to employee deductions",
    "The 2025–2026 minimum 20% tax on incomes over €250,000 (contribution différentielle)",
    "Tax credits and reductions (home help, donations) and actual work expenses instead of the 10% deduction",
    "Overtime exemptions and the Alsace-Moselle health contribution",
    "Shared custody (alternating residence) and disabled dependants' extra shares"
  ],
  "provisional": [
    "France taxes each year's income the following spring with that year's finance law. This uses the latest scale (indexed 0.9% by the 2026 finance law, applied to 2025 income), which is also the basis for withholding through 2026; the scale for 2026 income will be set by the 2027 finance law."
  ],
  "sources": [
    {
      "title": "Article 197 CGI — barème de l'impôt sur le revenu",
      "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000048862617"
