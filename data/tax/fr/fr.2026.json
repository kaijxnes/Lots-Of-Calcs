      "url": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000049371120"
    }
  ],
  "obtainedFrom": [
    {
      "title": "OpenFisca-France parameters (maintained with French public administrations)",
      "url": "https://github.com/openfisca/openfisca-france/tree/5cc6563749b88254b479ef89c98099cb9513d6cb/openfisca_france/parameters",
      "note": "Scale, décote, 10% deduction limits, PASS 2026 (€48,060), CNAV, Agirc-Arrco, CEG, CET, CSG and CRDS rates, commit of 23 Oct 2026."
    },
    {
      "title": "OpenFisca-France parameters, commit be579829 (27 Oct 2026)",
      "note": "plaf_qf: shares per child (art. 194) and caps of €1,807 per half-share and €4,262 for a single parent's first child (art. 197, values for 2025 income, matching this file's scale)."
    }
  ],
  "lastVerified": null,
  "lastChecked": null,
  "verifyAt": "https://simulateur-ir-ifi.impots.gouv.fr/calcul_impot/2026/",
  "tests": [
    {
      "gross": 25000,
      "note": "Pension 1,725 + 100 = 1,825; Agirc-Arrco + CEG 4.01% = 1,002.50; CSG base 24,562.50; CSG deductible 1,670.25. Net taxable 20,502.25, less 10% → 18,452.03. Tax 11% × 6,852.03 = 753.72; décote 897 − 341.06 = 555.94 → 198.",
      "expect": {
        "fr-net-taxable-pay": 20502.25,
        "fr-taxable": 18452.03,
        "fr-income-tax": 198,
        "net": 19591.94
      }
    },
    {
      "gross": 70000,
      "note": "Above the PASS: complementary 4.01% × 48,060 + 9.72% × 21,940 + 0.14% × 70,000 = 4,157.77. Taxable 51,812.45 → 1,977.69 + 6,670.04 = 8,647.73 → 8,648.",
      "expect": {
        "fr-pension-complementary": 4157.77,
        "fr-taxable": 51812.45,
        "fr-income-tax": 8648
      }
    },
    {
      "gross": 60000,
      "options": {
        "status": "married"
      },
      "note": "Two shares: taxable 44,337.14 → 22,168.57 per share, tax per share 1,384.81 + ... = 947.13 → × 2 = 1,894 after rounding; no décote.",
      "expect": {
        "fr-income-tax": 1894,
        "net": 45659.94
      }
    },
    {
      "gross": 400000,
      "note": "Taxable 318,392.12; high income contribution 3% × 68,392.12 = 2,051.76.",
      "expect": {
        "fr-income-tax": 119800,
        "fr-high-income": 2051.76
      }
    },
    {
      "gross": 40000,
      "options": {
        "status": "single",
        "children": 1
      },
      "note": "2.0 shares; tax = max(scale on every share, adults' shares less the cap); separate implementation of CGI art. 194 and 197.",
      "expect": {
        "fr-shares": 2.0,
        "fr-income-tax": 113
      }
    },
    {
      "gross": 60000,
      "options": {
        "status": "married",
        "children": 2
      },
      "note": "3.0 shares; tax = max(scale on every share, adults' shares less the cap); separate implementation of CGI art. 194 and 197.",
      "expect": {
        "fr-shares": 3.0,
        "fr-income-tax": 41
      }
    },
    {
      "gross": 120000,
      "options": {
        "status": "married",
        "children": 3
      },
      "note": "4.0 shares; tax = max(scale on every share, adults' shares less the cap); separate implementation of CGI art. 194 and 197.",
      "expect": {
        "fr-shares": 4.0,
        "fr-income-tax": 5737
      }
    },
    {
      "gross": 90000,
      "options": {
        "status": "single",
        "children": 2
      },
      "note": "2.5 shares; tax = max(scale on every share, adults' shares less the cap); separate implementation of CGI art. 194 and 197.",
      "expect": {
        "fr-shares": 2.5,
        "fr-income-tax": 7064
      }
    },
    {
      "gross": 250000,
      "options": {
        "status": "married",
        "children": 2
      },
      "note": "3.0 shares; tax = max(scale on every share, adults' shares less the cap); separate implementation of CGI art. 194 and 197.",
      "expect": {
        "fr-shares": 3.0,
        "fr-income-tax": 42892
      }
    }
  ]
}
