    {
      "id": "nl-pension-amount",
      "label": "Pension contribution",
      "note": "Your share of the employer pension scheme's premium, as a percentage of gross pay. Schemes usually charge it on pay above a franchise, so check your payslip for the euro amount.",
      "value": {
        "pct": {
          "input": "pensionPct"
        },
        "of": "gross"
      }
    },
    {
      "id": "nl-30-allowance",
      "label": "30% ruling tax-free allowance",
      "show": true,
      "note": "Under the 30% ruling (expatregeling) up to 30% of pay, including the allowance, is paid tax-free, on pay up to €262,000 (a maximum of €78,600 for a full year). The pay left after the allowance must stay above the salary norm — €48,013 in 2026, or €36,497 if you're under 30 with a master's degree — so near the norm the allowance is cut back to keep it there. It lasts up to 5 years.",
      "value": {
        "option": "ruling30",
        "cases": {
          "no": 0,
          "yes": {
            "min": [
              {
                "pct": 30,
                "of": {
                  "min": [
                    "gross",
                    262000
                  ]
                }
              },
              {
                "max": [
                  0,
