      "group": "tax",
      "mayBeNegative": true,
      "note": "€612 with one child, €828 with two and €273 more for each further child (2026). It is paid out even when there is no tax to set it against.",
      "charge": {
        "if": {
          "gt": [
            {
              "sum": [
                {
