    {
      "id": "at-familienbonus",
      "label": "Familienbonus Plus",
      "show": true,
      "note": "€2,000.16 a year per child under 18 (12 × €166.68) and €700.08 per child over 18 still receiving family allowance (12 × €58.34), or half each if parents split it. It can only cut tax to zero (EStG §33 Abs. 3a).",
      "value": {
        "mul": [
          {
            "option": "bonusShare",
            "cases": {
              "full": 1,
              "half": 0.5
            }
          },
          {
            "sum": [
              {
                "mul": [
                  2000.16,
                  {
                    "input": "children"
                  }
                ]
              },
              {
                "mul": [
                  700.08,
                  {
                    "input": "children18"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "at-income-tax",
      "label": "Income tax on monthly pay (Lohnsteuer)",
      "group": "tax",
      "note": "2026 tariff: nothing to €13,539, then 20%, 30%, 40%, 48% and 50%, and 55% above €1 million. Less the €496 commuter tax credit (Verkehrsabsetzbetrag) and its €804 supplement for lower incomes. Less the Familienbonus Plus for children.",
      "charge": {
        "max": [
          0,
          {
            "sub": [
              {
                "brackets": [
                  [
                    0,
                    0
                  ],
                  [
                    13539,
                    20
                  ],
                  [
