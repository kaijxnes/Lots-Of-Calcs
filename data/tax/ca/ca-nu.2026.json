      "id": "ca-nu-credits",
      "label": "Nunavut non-refundable credits",
      "note": "4% of the basic personal amount ($19,659) and the base CPP and EI contributions.",
      "value": {
        "pct": 4,
        "of": {
          "sum": [
            19659,
            "ca-contributions-credit"
          ]
        }
      }
    },
    {
      "id": "ca-nu-basic",
      "label": "Basic Nunavut tax",
      "value": {
        "max": [
          0,
          {
            "sub": [
              {
                "brackets": [
                  [
                    0,
                    4
                  ],
                  [
                    55801,
                    7
                  ],
                  [
                    111602,
                    9
                  ],
                  [
                    181439,
                    11.5
                  ]
                ],
                "of": "ca-taxable"
              },
              "ca-nu-credits"
            ]
          }
        ]
      }
    },
    {
      "id": "ca-nu-income-tax",
      "label": "Nunavut income tax",
      "group": "tax",
      "note": "4% to $55,801, 7% to $111,602, 9% to $181,439, 11.5% above, less credits.",
      "charge": {
        "sum": [
          "ca-nu-basic"
        ]
      }
    }
  ],
