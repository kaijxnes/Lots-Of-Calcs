{
  "id": "ca-nt",
  "name": "Northwest Territories",
  "appliesTo": "Residents of Northwest Territories on 31 December",
  "kind": "region",
  "country": "CA",
  "parent": "ca",
  "standalone": true,
  "taxYear": {
    "label": "2026",
    "start": "2026-01-01",
    "end": "2026-12-31"
  },
  "items": [
    {
      "id": "ca-nt-credits",
      "label": "Northwest Territories non-refundable credits",
      "note": "5.9% of the basic personal amount ($18,198) and the base CPP and EI contributions.",
      "value": {
        "pct": 5.9,
        "of": {
          "sum": [
            18198,
            "ca-contributions-credit"
          ]
        }
      }
    },
    {
      "id": "ca-nt-basic",
      "label": "Basic Northwest Territories tax",
      "value": {
        "max": [
          0,
          {
            "sub": [
              {
                "brackets": [
                  [
                    0,
                    5.9
                  ],
                  [
                    53003,
                    8.6
                  ],
                  [
                    106009,
                    12.2
                  ],
                  [
                    172346,
                    14.05
                  ]
                ],
                "of": "ca-taxable"
              },
              "ca-nt-credits"
            ]
          }
        ]
      }
    },
    {
      "id": "ca-nt-income-tax",
      "label": "Northwest Territories income tax",
      "group": "tax",
      "note": "5.9% to $53,003, 8.6% to $106,009, 12.2% to $172,346, 14.05% above, less credits.",
      "charge": {
        "sum": [
          "ca-nt-basic"
        ]
      }
    }
  ],
  "notModelled": [
    "Provincial credits other than the basic personal amount and CPP/EI"
