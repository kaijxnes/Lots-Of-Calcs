{
  "id": "ca-ab",
  "name": "Alberta",
  "appliesTo": "Residents of Alberta on 31 December",
  "kind": "region",
  "country": "CA",
  "parent": "ca",
  "standalone": true,
  "taxYear": {
    "label": "2027",
    "start": "2027-01-01",
    "end": "2027-12-31"
  },
  "items": [
    {
      "id": "ca-ab-credits",
      "label": "Alberta non-refundable credits",
      "note": "8% of the basic personal amount ($23,225) and the base CPP and EI contributions.",
      "value": {
        "pct": 8,
        "of": {
          "sum": [
            23225,
            "ca-contributions-credit"
          ]
        }
      }
    },
    {
      "id": "ca-ab-supplemental",
      "label": "Alberta supplemental credit",
      "note": "A quarter of the non-refundable credits above $4,993.92.",
      "value": {
        "mul": [
          0.25,
          {
            "max": [
              0,
              {
                "sub": [
                  "ca-ab-credits",
                  4993.92
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ca-ab-basic",
      "label": "Basic Alberta tax",
      "value": {
        "max": [
          0,
          {
            "sub": [
              {
                "brackets": [
                  [
                    0,
                    8
                  ],
                  [
                    62424,
                    10
                  ],
                  [
                    157344,
                    12
                  ],
                  [
                    188813,
                    13
                  ],
                  [
                    251750,
                    14
                  ],
                  [
                    377625,
                    15
                  ]
                ],
                "of": "ca-taxable"
              },
              "ca-ab-credits",
              "ca-ab-supplemental"
            ]
          }
        ]
      }
    },
    {
      "id": "ca-ab-income-tax",
      "label": "Alberta income tax",
      "group": "tax",
      "note": "8% to $62,424, 10% to $157,344, 12% to $188,813, 13% to $251,750, 14% to $377,625, 15% above, less credits and the supplemental credit.",
      "charge": {
        "sum": [
          "ca-ab-basic"
        ]
      }
    }
  ],
  "notModelled": [
    "Provincial credits other than the basic personal amount and CPP/EI"
  ],
