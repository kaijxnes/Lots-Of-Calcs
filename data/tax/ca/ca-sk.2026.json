  },
  "items": [
    {
      "id": "ca-sk-credits",
      "label": "Saskatchewan non-refundable credits",
      "note": "10.5% of the basic personal amount ($20,381) and the base CPP and EI contributions.",
      "value": {
        "pct": 10.5,
        "of": {
          "sum": [
            20381,
            "ca-contributions-credit"
          ]
        }
      }
    },
    {
      "id": "ca-sk-basic",
      "label": "Basic Saskatchewan tax",
      "value": {
        "max": [
          0,
          {
            "sub": [
              {
                "brackets": [
                  [
                    0,
                    10.5
                  ],
                  [
                    54532,
                    12.5
                  ],
                  [
                    155805,
                    14.5
                  ]
                ],
                "of": "ca-taxable"
              },
              "ca-sk-credits"
            ]
          }
        ]
      }
    },
    {
      "id": "ca-sk-income-tax",
      "label": "Saskatchewan income tax",
      "group": "tax",
      "note": "10.5% to $54,532, 12.5% to $155,805, 14.5% above, less credits.",
      "charge": {
        "sum": [
          "ca-sk-basic"
        ]
      }
    }
  ],
  "notModelled": [
    "Provincial credits other than the basic personal amount and CPP/EI"
