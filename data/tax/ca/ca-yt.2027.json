{
  "id": "ca-yt",
  "name": "Yukon",
  "appliesTo": "Residents of Yukon on 31 December",
  "kind": "region",
  "country": "CA",
  "parent": "ca",
  "standalone": true,
  "taxYear": {
    "label": "2027",
    "start": "2027-01-01",
    "end": "2027-12-31"
  },
  "items": [
    {
      "id": "ca-yt-credits",
      "label": "Yukon non-refundable credits",
      "note": "6.4% of the basic personal amount (the federal amount) and the base CPP and EI contributions, plus the Canada employment amount.",
      "value": {
        "pct": 6.4,
        "of": {
          "sum": [
            "ca-bpa",
            "ca-contributions-credit",
            {
              "min": [
                "gross",
                1540
              ]
            }
          ]
        }
      }
    },
    {
      "id": "ca-yt-basic",
      "label": "Basic Yukon tax",
      "value": {
        "max": [
          0,
          {
            "sub": [
              {
                "brackets": [
                  [
                    0,
                    6.4
                  ],
                  [
                    60044,
                    9
                  ],
                  [
                    120088,
                    10.9
                  ],
                  [
                    186157,
                    12.8
                  ],
                  [
                    500000,
                    15
                  ]
                ],
                "of": "ca-taxable"
              },
              "ca-yt-credits"
            ]
          }
        ]
      }
    },
    {
      "id": "ca-yt-income-tax",
      "label": "Yukon income tax",
      "group": "tax",
      "note": "6.4% to $60,044, 9% to $120,088, 10.9% to $186,157, 12.8% to $500,000, 15% above, less credits.",
      "charge": {
        "sum": [
          "ca-yt-basic"
        ]
      }
    }
  ],
  "notModelled": [
    "Provincial credits other than the basic personal amount and CPP/EI"
  ],
