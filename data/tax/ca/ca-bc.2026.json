{
  "id": "ca-bc",
  "name": "British Columbia",
  "appliesTo": "Residents of British Columbia on 31 December",
  "kind": "region",
  "country": "CA",
  "parent": "ca",
  "standalone": true,
  "taxYear": {
    "label": "2026",
    "start": "2026-01-01",
    "end": "2026-12-31"
  },
  "items": [
    {
      "id": "ca-bc-credits",
      "label": "British Columbia non-refundable credits",
      "note": "5.6% of the basic personal amount ($13,216) and the base CPP and EI contributions.",
      "value": {
        "pct": 5.6,
        "of": {
          "sum": [
            13216,
            "ca-contributions-credit"
          ]
        }
      }
    },
    {
      "id": "ca-bc-basic",
      "label": "Basic British Columbia tax",
      "value": {
        "max": [
          0,
          {
            "sub": [
              {
                "brackets": [
                  [
                    0,
                    5.6
                  ],
                  [
                    50363,
                    7.7
                  ],
                  [
                    100728,
                    10.5
                  ],
                  [
                    115648,
                    12.29
                  ],
                  [
                    140430,
                    14.7
                  ],
                  [
                    190405,
                    16.8
                  ],
                  [
                    265545,
                    20.5
                  ]
                ],
                "of": "ca-taxable"
              },
              "ca-bc-credits"
            ]
          }
        ]
      }
    },
    {
      "id": "ca-bc-reduction",
      "label": "BC tax reduction",
      "note": "Up to $690, reduced by 3.56% of taxable income over $25,570 (gone by $44,952).",
      "value": {
        "min": [
          "ca-bc-basic",
          {
            "max": [
              0,
              {
                "sub": [
                  690,
                  {
                    "pct": 3.56,
                    "of": {
                      "max": [
                        0,
                        {
                          "sub": [
                            "ca-taxable",
                            25570
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "ca-bc-income-tax",
      "label": "British Columbia income tax",
      "group": "tax",
      "note": "5.6% to $50,363, 7.7% to $100,728, 10.5% to $115,648, 12.29% to $140,430, 14.7% to $190,405, 16.8% to $265,545, 20.5% above, less credits and the BC tax reduction.",
      "charge": {
        "sub": [
          "ca-bc-basic",
          "ca-bc-reduction"
        ]
      }
    }
  ],
  "notModelled": [
    "Provincial credits other than the basic personal amount and CPP/EI"
  ],
