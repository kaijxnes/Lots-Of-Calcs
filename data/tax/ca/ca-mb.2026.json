{
  "id": "ca-mb",
  "name": "Manitoba",
  "appliesTo": "Residents of Manitoba on 31 December",
  "kind": "region",
  "country": "CA",
  "parent": "ca",
  "standalone": true,
  "taxYear": {
    "label": "2026",
    "start": "2026-01-01",
    "end": "2026-12-31"
  },
  "items": [
    {
      "id": "ca-mb-bpa",
      "label": "Manitoba basic personal amount",
      "show": true,
      "note": "$15,780, reduced to nothing as taxable income rises from $200,000 to $400,000.",
      "value": {
        "taper": 15780,
        "from": 200000,
        "per": {
          "div": [
            15780,
            200000
          ]
        },
        "of": "ca-taxable"
      }
    },
    {
      "id": "ca-mb-credits",
      "label": "Manitoba non-refundable credits",
      "note": "10.8% of the basic personal amount (see above) and the base CPP and EI contributions.",
      "value": {
        "pct": 10.8,
        "of": {
          "sum": [
            "ca-mb-bpa",
            "ca-contributions-credit"
          ]
        }
      }
    },
    {
      "id": "ca-mb-basic",
      "label": "Basic Manitoba tax",
      "value": {
        "max": [
          0,
          {
            "sub": [
              {
                "brackets": [
                  [
                    0,
                    10.8
                  ],
                  [
                    47000,
                    12.75
                  ],
                  [
                    100000,
                    17.4
                  ]
                ],
                "of": "ca-taxable"
              },
              "ca-mb-credits"
            ]
          }
        ]
      }
    },
    {
      "id": "ca-mb-income-tax",
      "label": "Manitoba income tax",
      "group": "tax",
      "note": "10.8% to $47,000, 12.75% to $100,000, 17.4% above, less credits.",
      "charge": {
        "sum": [
          "ca-mb-basic"
        ]
      }
    }
  ],
  "notModelled": [
    "Provincial credits other than the basic personal amount and CPP/EI",
    "Low-income tax reductions claimed on the return"
  ],
  "provisional": [],
